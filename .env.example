# Needed for live and record evaluation runs. Replay runs and the tests never use it.
ANTHROPIC_API_KEY=

# Model used by the agent. The smallest current model is the default.
ANTHROPIC_MODEL=claude-haiku-5-5

# Base URL of a RAG Knowledge Assistant server (github.com/LacerdaTraderCode/rag-knowledge-assistant).
# When set, the glossary tool searches that knowledge base instead of the local glossary file.
KNOWLEDGE_BASE_URL=

# Send spans to an OpenTelemetry collector (OTLP over HTTP) instead of printing them.
OTEL_EXPORTER_OTLP_ENDPOINT=
